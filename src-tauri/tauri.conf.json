{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubGauge",
  "version": "0.1.10",
  "identifier": "app.subgauge.desktop",
  "build": {
    "beforeDevCommand": "npm run notices && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run notices",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "float",
        "title": "SubGauge",
        "url": "index.html",
        "width": 316,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../docs/user-guide.md": "README.md",
      "../release/legal/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../release/legal/RUST-STANDARD-LIBRARY-NOTICES.html": "RUST-STANDARD-LIBRARY-NOTICES.html"
    },
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "Sub2API 个人用量悬浮窗",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false, "installerHooks": "installer-hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5RUQ3QjE3QjIxODYyNzEKUldSeFloaXlGM3Z0U1pjZ1p0cnJOc0phOG45UW1vTllaVGhMMVNidklaVEtraE1zenk0L2VpL0oK",
      "endpoints": ["https://raw.githubusercontent.com/YuVerseX/SubGauge/main/updates/preview.json"],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "passive" }
    }
  }
}
