{
  "name": "subgauge",
  "version": "0.1.9",
  "description": "Windows desktop gauge for personal Sub2API usage",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test:layout": "node scripts/float-layout-probe.cjs",
    "test:freshness": "node scripts/freshness-regression.cjs",
    "test:details": "node scripts/detail-regression.cjs",
    "test:updates": "node scripts/updater-regression.cjs",
    "test:desktop": "node scripts/desktop-regression.cjs",
    "test:update-packages": "node scripts/updater-package-check.cjs",
    "notices": "node scripts/generate-notices.cjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 dev",
    "check:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 check",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 test",
    "fmt:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 fmt",
    "lint:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 lint",
    "verify": "npm run build && npm run notices && npm run test:layout && npm run test:details && npm run test:desktop && npm run test:freshness && npm run test:updates && npm run test:update-packages && npm run fmt:rust && npm run lint:rust && npm run test:rust",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 build",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:update-manifest": "node scripts/prepare-update-manifest.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@lucide/vue": "1.49.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.11"
  }
}
